<%- include('partials/head') %>
<div class="pagehead"><h1>تکمیل سفارش</h1><small>مرحله آخر — اطلاعات تحویل</small></div>
<div class="odetail"><form class="card2" method="post" action="?_csrf=<%= csrf %>"><h3><%- ic('pin') %> اطلاعات گیرنده</h3>
<div class="row2"><div><label>نام و نام خانوادگی</label><input name="name" required value="<%= (user.first_name+' '+user.last_name).trim() %>"></div><div><label>موبایل</label><input name="phone" required dir="ltr" value="<%= user.phone %>"></div></div>
<% if(addrs&&addrs.length){ %><label>انتخاب از آدرس‌های من</label><div class="apicks"><% addrs.forEach(a=>{ %><button type="button" class="apick <%= a.is_default?'on':'' %>" data-address="<%= a.address %>" data-name="<%= a.receiver %>" data-phone="<%= a.receiver_phone %>" data-province="<%= a.province %>" data-city="<%= a.city %>" data-postal="<%= a.postal_code %>"><b><%- ic('pin') %> <%= a.title %></b><small><%= (a.city?a.city+'، ':'')+a.address.slice(0,50) %></small></button><% }) %><a class="apick add" href="/account#addr"><%- ic('plus') %> آدرس جدید</a></div><% } %><div class="row2"><div><label>استان</label><input name="province" id="copv" list="provs" required maxlength="50" value="<%= (addrs.find(a=>a.is_default)||{}).province||'' %>"></div><div><label>شهر</label><input name="city" id="coct" required maxlength="50" value="<%= (addrs.find(a=>a.is_default)||{}).city||'' %>"></div></div>
<label>کد پستی (۱۰ رقم)</label><input name="postal_code" id="copc" required dir="ltr" inputmode="numeric" maxlength="10" pattern="[0-9۰-۹]{10}" value="<%= (addrs.find(a=>a.is_default)||{}).postal_code||'' %>">
<label>نشانی دقیق (خیابان، کوچه، پلاک، واحد)</label><textarea id="coaddr" name="address" required rows="3"><%= user.address %></textarea>
<label>روش ارسال</label><div class="shipm"><label class="sm on"><input type="radio" name="ship_method" value="pishtaz" checked data-fee="<%= shipP %>"><span><b><%- ic('mail') %> پست پیشتاز</b><small>تحویل ۳ تا ۵ روز کاری · <%= collect?'پس‌کرایه (پرداخت درب منزل)':shipP?fa(shipP)+' تومان':'رایگان' %></small></span></label><label class="sm"><input type="radio" name="ship_method" value="tipax" data-fee="<%= shipT %>"><span><b><%- ic('truck') %> تیپاکس</b><small>تحویل ۱ تا ۳ روز کاری · <%= collect?'پس‌کرایه (پرداخت درب منزل)':shipT?fa(shipT)+' تومان':'رایگان' %></small></span></label></div>
<datalist id="provs"><% ['آذربایجان شرقی','آذربایجان غربی','اردبیل','اصفهان','البرز','ایلام','بوشهر','تهران','چهارمحال و بختیاری','خراسان جنوبی','خراسان رضوی','خراسان شمالی','خوزستان','زنجان','سمنان','سیستان و بلوچستان','فارس','قزوین','قم','کردستان','کرمان','کرمانشاه','کهگیلویه و بویراحمد','گلستان','گیلان','لرستان','مازندران','مرکزی','هرمزگان','همدان','یزد'].forEach(p=>{ %><option value="<%= p %>"><% }) %></datalist><label>توضیحات (اختیاری)</label><textarea name="note" rows="2"></textarea>
<p class="hint" style="margin-top:16px">درگاه پرداخت به‌زودی فعال می‌شود؛ سفارش با وضعیت «در انتظار پرداخت» ثبت می‌شود.</p><button class="btn lg" style="width:100%"><%- ic('check') %> ثبت نهایی سفارش</button></form>
<div class="card2"><h3><%- ic('bag') %> خلاصه سفارش</h3><% items.forEach(i=>{ %><div class="oi"><span class="ot"><% if(i.p.image){ %><img src="<%= i.p.image %>" alt=""><% }else{ %><%- ic('bottle') %><% } %></span><div style="flex:1"><b style="font-size:14px"><%= i.p.name %></b><br><small style="color:var(--mut)"><%= fa(i.qty) %> عدد</small></div><b><%= fa(i.price*i.qty) %></b></div><% }) %>
<div class="kv2"><span>جمع کالاها</span><b><%= fa(sub) %></b><% if(off){ %><span>تخفیف</span><b style="color:var(--red)">-<%= fa(off) %></b><% } %><span>ارسال</span><b id="shv"><%= collect?'پس‌کرایه (درب منزل)':ship?fa(ship):'رایگان' %></b></div><div class="total"><span>قابل پرداخت</span><b><span id="tov"><%= fa(sub-off+ship) %></span> تومان</b></div></div></div>
<script nonce="<%= nonce %>">const base=<%= sub-off %>,F=n=>String(n).replace(/\B(?=(\d{3})+(?!\d))/g,"،").replace(/\d/g,d=>"۰۱۲۳۴۵۶۷۸۹"[d]);document.querySelectorAll('[name=ship_method]').forEach(r=>r.addEventListener("change",()=>{const f=+r.dataset.fee;document.querySelectorAll(".sm").forEach(x=>x.classList.toggle("on",x.contains(r)&&r.checked));document.getElementById("shv").textContent=f?F(f):<%- collect?'"پس‌کرایه (درب منزل)"':'"رایگان"' %>;document.getElementById("tov").textContent=F(base+f)}));</script>
<%- include('partials/foot') %>
