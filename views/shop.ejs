<%- include('partials/head') %>
<div class="pagehead"><div style="font-size:13px;opacity:.8"><a href="/">خانه</a> / <%= title %></div><h1><%= title %></h1><small><%= fa(products.length) %> محصول</small></div>
<% if(typeof subs!=='undefined'&&(subs.length||parent)){ const kids=subs.length?subs:[]; %><div class="subchips"><% if(parent){ %><a href="/category/<%= parent.slug %>">‹ <%= parent.name %></a><% } %><% kids.forEach((k,i)=>{ %><a href="/category/<%= k.slug %>" style="--j:<%= i %>"><%= k.name %></a><% }) %></div><% } %>
<div class="filters"><% const base=category?'/category/'+category.slug:'/shop'; const qs=(s)=>{const u=new URLSearchParams();if(q)u.set('q',q);if(f.cat)u.set('cat',f.cat);if(f.brand)u.set('brand',f.brand);if(f.min)u.set('min',f.min);if(f.max)u.set('max',f.max);if(f.stock)u.set('stock',1);if(f.deals)u.set('deals',1);if(s)u.set('sort',s);return base+'?'+u.toString()}; %>
<a class="<%= !sort?'on':'' %>" href="<%= qs('') %>">جدیدترین</a><a class="<%= sort=='cheap'?'on':'' %>" href="<%= qs('cheap') %>">ارزان‌ترین</a><a class="<%= sort=='exp'?'on':'' %>" href="<%= qs('exp') %>">گران‌ترین</a><a class="<%= sort=='off'?'on':'' %>" href="<%= qs('off') %>">بیشترین تخفیف</a></div>
<% const base2=category?'/category/'+category.slug:'/shop'; %><form class="filterbar" method="get" action="<%= base2 %>"><% if(q){ %><input type="hidden" name="q" value="<%= q %>"><% } %><% if(sort){ %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
<% if(fcats){ %><div><label>دسته‌بندی</label><select name="cat"><option value="">همه</option><% fcats.forEach(c=>{ %><option value="<%= c.id %>" <%= f.cat===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div><% } %>
<% if(brands.length){ %><div><label>برند</label><select name="brand"><option value="">همه</option><% brands.forEach(b=>{ %><option <%= f.brand===b?'selected':'' %>><%= b %></option><% }) %></select></div><% } %>
<div><label>حداقل قیمت (تومان)</label><input name="min" inputmode="numeric" value="<%= f.min %>" placeholder="۰"></div><div><label>حداکثر قیمت (تومان)</label><input name="max" inputmode="numeric" value="<%= f.max %>" placeholder="نامحدود"></div>
<div class="chk"><input type="checkbox" id="fs" name="stock" value="1" <%= f.stock?'checked':'' %>><label for="fs">فقط موجود</label></div><div class="chk"><input type="checkbox" id="fd2" name="deals" value="1" <%= f.deals?'checked':'' %>><label for="fd2">فقط تخفیف‌دار</label></div>
<div style="flex:0 0 auto;flex-direction:row;gap:8px"><button class="btn sm">اعمال فیلتر</button><a class="btn o sm" href="<%= base2 %>">پاک‌کردن</a></div></form>
<% if(!products.length){ %><div class="box" style="text-align:center"><div style="font-size:60px"><%- ic('search') %></div><p>محصولی یافت نشد.</p><a class="btn" href="/shop">همه محصولات</a></div><% } %><div class="grid"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div>
<%- include('partials/foot') %>
