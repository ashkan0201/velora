<%- include('partials/head') %>
<section class="hero"><div class="hbig"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
<div class="orbit"><i></i><i></i><i></i><b style="top:-6px;left:48%"><%- ic('lipstick') %></b><b style="bottom:20%;right:-6px;animation-delay:-1s"><%- ic('flower') %></b><b style="bottom:-10px;left:30%;animation-delay:-2s"><%- ic('spark') %></b><b style="top:40%;left:-8px;animation-delay:-3s"><%- ic('bottle') %></b></div>
<span style="letter-spacing:6px;color:var(--gold2);font-size:13px">VELORA · BEAUTY</span><h1><%= S.hero_title %></h1><p><%= S.hero_sub %></p>
<div class="hbtns"><a class="btn lg" href="/shop">شروع خرید <%- ic('spark') %></a><a class="btn o lg" style="color:#fff;border-color:#fff8" href="/shop?deals=1"><%- ic('fire') %> تخفیف‌ها</a></div></div>
<div class="scene" aria-hidden="true"><span class="rp r1"></span><span class="rp r2"></span><span class="rp r3"></span><div class="core"><img src="/img/logo.svg" alt="VELORA"></div><% ['bottle','lipstick','perfume','drop','spark','star'].forEach((n,i)=>{ %><span class="fl" style="--i:<%= i %>"><%- ic(n) %></span><% }) %></div></section>

<% if(S.sec_banners!=='0'&&banners.length){ const bn=banners.slice(0,8),k=bn.length; %><section class="sec"><div class="bnr n<%= k>4?'x':k %>" data-n="<%= k %>"><% bn.forEach((b,i)=>{ %><a class="bn" href="<%= b.link %>" style="--i:<%= i %>;<%= b.image?`background-image:url('${b.image}')`:'' %>"><span class="bn-g"></span><% if(b.icon!=='none'){ %><span class="bn-ic"><%- ic(b.icon||['bottle','flower','lipstick','perfume','drop','spark','eye','gift'][i%8]) %></span><% } %><span class="bn-t"><h3><%= b.title %></h3><% if(b.subtitle){ %><p><%= b.subtitle %></p><% } %><em>مشاهده <%- ic('arrowl') %></em></span></a><% }) %></div></section><% } %>
<% if(S.sec_deals!=='0'&&deals.length){ const end=deals.map(d=>d.deal_ends).filter(Boolean).sort()[0]; %><section class="sec deals"><h2><span class="t"><%- ic('fire') %> تخفیف‌های ویژه امروز <% if(end){ %><span class="timer" data-end="<%= end %>"></span><% } %></span><a href="/shop?deals=1" style="color:#f0c4cb">همه تخفیف‌ها ‹</a></h2><div class="hscroll<%= deals.length<=4?' few':'' %>"><% deals.slice(0,8).forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section><% } %>
<% if(S.sec_deals!=='0'&&!deals.length&&best.length){ %><section class="sec deals"><h2><span class="t"><%- ic('fire') %> محبوب‌ترین‌ها</span><a href="/shop" style="color:#f0c4cb">همه محصولات ‹</a></h2><div class="hscroll<%= best.length<=4?' few':'' %>"><% best.slice(0,8).forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section><% } %>
<% if(S.sec_brands!=='0'&&(S.brands_list||'').trim()){ %><section class="sec"><div class="brands" style="--bs:<%= Math.max(5,+S.brands_speed||25) %>s"><div><% const bl=(S.brands_list||'').split(/\n|،|,/).map(x=>x.trim()).filter(Boolean); for(let k=0;k<4;k++){ %><% bl.forEach(b=>{ %><span><%= b %></span><% }) %><% } %></div></div></section><% } %>
<% if(S.sec_featured!=='0'&&featured.length){ %><section class="sec deals"><h2><span class="t"><%- ic('star') %> محصولات منتخب</span><a href="/shop" style="color:#f0c4cb">مشاهده همه ‹</a></h2><div class="hscroll<%= featured.length<=4?' few':'' %>"><% featured.slice(0,8).forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section><% } %>
<% if(S.sec_stats!=='0'){ %><section class="sec stats"><% for(let i=1;i<=4;i++){ %><div><b data-count="<%= +S['stat'+i+'_val']||0 %>">۰</b><%= S['stat'+i+'_label'] %></div><% } %></section><% } %>
<% if(S.sec_latest!=='0'&&latest.length){ %><section class="sec"><h2><span class="t"><%- ic('spark') %> تازه‌ترین‌ها</span><a href="/shop">مشاهده همه ‹</a></h2><div class="hscroll<%= latest.length<=4?' few':'' %>"><% latest.slice(0,8).forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section><% } %>
<% if(S.sec_trust!=='0'){ %><section class="sec trust"><div><i><%- ic('shield') %></i><b>ضمانت اصالت</b><br><small>تمام کالاها ۱۰۰٪ اورجینال</small></div><div><i><%- ic('truck') %></i><b>ارسال سریع</b><br><small>تحویل در کمترین زمان</small></div><div><i><%- ic('ret') %></i><b>۷ روز بازگشت</b><br><small>بدون دردسر</small></div><div><i><%- ic('headset') %></i><b>پشتیبانی</b><br><small><%= S.hours %></small></div></section><% } %>
<% if(S.sec_testi!=='0'&&testi.length){ %><section class="sec"><h2><span class="t"><%- ic('chat') %> نظر مشتریان</span></h2><div class="testi">
<% testi.forEach(t=>{ const nm=t.name||'مشتری'; %><div class="tc"><span class="qm">“</span><p><%= t.text %></p><footer><span class="av"><%= nm[0] %></span><b><%= nm %></b><%- stars(t.stars||5) %></footer></div><% }) %></div></section><% } %>
<% if(S.sec_news!=='0'){ %><section class="sec nl"><span class="nb nb1"></span><span class="nb nb2"></span><div class="nl-in"><div class="nl-ic"><%- ic('mail') %></div><div class="nl-tx"><h2>عضو باشگاه VELORA شوید</h2><p>از تخفیف‌های اختصاصی و محصولات جدید، زودتر از همه باخبر شوید.</p></div>
<form class="nl-f" id="nlf" novalidate><input type="email" name="email" placeholder="ایمیل خود را وارد کنید" required autocomplete="email" dir="ltr"><button class="btn" type="submit"><%- ic('spark') %> عضویت</button></form><small class="nl-m" id="nlm"></small></div></section><% } %>
<%- include('partials/foot') %>