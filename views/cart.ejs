<%- include('partials/head') %><div class="pagehead"><h1><%- ic('bag') %> سبد خرید</h1></div>
<% if(!items.length){ %><div class="box" style="text-align:center"><div style="font-size:60px"><%- ic('cart') %></div><p>سبد شما خالی است.</p><a class="btn" href="/shop">ادامه خرید</a></div><% }else{ %>
<table><tr><th>محصول</th><th>قیمت</th><th>تعداد</th><th>جمع</th><th></th></tr><% items.forEach(i=>{ %><tr><td><a href="/product/<%= i.p.slug %>" style="display:flex;align-items:center;gap:12px"><% if(i.p.image){ %><img class="thumb" style="width:56px;height:56px" src="<%= i.p.image %>" alt=""><% } %><b><%= i.p.name %></b></a></td><td><%= fa(i.price) %></td>
<td><form method="post" action="/cart/set?_csrf=<%= csrf %>" style="display:flex;gap:6px"><input type="hidden" name="id" value="<%= i.p.id %>"><input type="number" name="qty" value="<%= i.qty %>" min="0" max="<%= i.p.stock %>" style="width:80px"><button class="btn sm o">بروزرسانی</button></form></td><td><%= fa(i.price*i.qty) %></td><td><form method="post" action="/cart/remove?_csrf=<%= csrf %>" class="rmform"><input type="hidden" name="id" value="<%= i.p.id %>"><button class="rm" title="حذف از سبد" aria-label="حذف <%= i.p.name %>"><%- ic('trash') %></button></form></td></tr><% }) %></table>
<form method="post" action="/cart/clear?_csrf=<%= csrf %>" data-confirm="سبد خرید خالی شود؟" style="margin-top:14px"><button class="btn sm o"><%- ic('trash') %> خالی کردن سبد</button></form>
<div class="row2" style="margin-top:20px"><form class="box" style="margin:0" method="post" action="/cart/coupon?_csrf=<%= csrf %>"><b><%- ic('ticket') %> کد تخفیف</b><div style="display:flex;gap:8px;margin-top:8px"><input name="code" placeholder="مثلاً WELCOME10" value="<%= code %>" style="text-transform:uppercase"><button class="btn sm">اعمال</button></div></form>
<div class="box" style="margin:0"><p>جمع کالاها: <b><%= fa(items.reduce((a,i)=>a+i.price*i.qty,0)) %></b> تومان</p><% if(off){ %><p style="color:var(--red)">تخفیف کد: -<%= fa(off) %> تومان</p><% } %><p>هزینه ارسال: <b><%= collect?'پس‌کرایه (درب منزل)':ship?fa(ship)+' تومان':'رایگان' %></b></p><p style="font-size:20px">قابل پرداخت: <b><%= fa(sub-off+ship) %></b> تومان</p><a class="btn lg" style="width:100%" href="/checkout">ادامه و ثبت سفارش</a></div></div><% } %>
<%- include('partials/foot') %>
