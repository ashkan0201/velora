<%- include('partials/head') %>
<% if(fresh){ %><div class="success"><div class="chk"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24"/><path d="M14 27l8 8 16-17"/></svg></div><h2>سفارش شما ثبت شد!</h2><p>شمارهٔ پیگیری: <b>#<%= fa(o.id) %></b> — به‌زودی با شما تماس می‌گیریم.</p><i class="cf c1"></i><i class="cf c2"></i><i class="cf c3"></i><i class="cf c4"></i><i class="cf c5"></i><i class="cf c6"></i></div><% } %>
<div class="crumbs"><a href="/account/orders">سفارش‌های من</a> / سفارش #<%= fa(o.id) %></div>
<div class="card2"><div class="ohead"><div><h1 style="margin:0;font-size:24px">سفارش #<%= fa(o.id) %></h1><small style="color:var(--mut)">ثبت‌شده در <%= fd(o.created) %></small></div><% const s=ST[o.status]||[o.status,'mute']; %><span class="pill <%= s[1] %>" style="font-size:14px;padding:3px 16px"><%= s[0] %></span></div><%- include('partials/track',{o}) %></div>
<div class="odetail"><div class="card2"><h3><%- ic('bag') %> اقلام سفارش</h3><% items.forEach((i,n)=>{ %><div class="oi" style="--n:<%= n %>"><span class="ot big"><% if(i.image){ %><img src="<%= i.image %>" alt=""><% }else{ %><%- ic('bottle') %><% } %></span><div style="flex:1"><% if(i.slug){ %><a href="/product/<%= i.slug %>"><b><%= i.name %></b></a><% }else{ %><b><%= i.name %></b><% } %><br><small style="color:var(--mut)"><%= fa(i.qty) %> × <%= fa(i.price) %> تومان</small></div><b><%= fa(i.qty*i.price) %></b></div><% }) %></div>
<div><div class="card2"><h3><%- ic('card') %> خلاصه پرداخت</h3><div class="kv2"><span>جمع کالاها</span><b><%= fa(o.total+o.discount_amount-(o.ship_cost||0)-(o.pack_cost||0)) %></b><% if(o.discount_amount){ %><span>تخفیف (<%= o.coupon %>)</span><b style="color:var(--red)">-<%= fa(o.discount_amount) %></b><% } %><span>ارسال</span><b><%= o.ship_collect?'پس‌کرایه':o.ship_cost?fa(o.ship_cost):'رایگان' %></b><% if(o.pack_cost){ %><span>هزینه بسته‌بندی</span><b><%= fa(o.pack_cost) %></b><% } %></div><div class="total"><span>مبلغ کل</span><b><%= fa(o.total) %> تومان</b></div></div>
<div class="card2"><h3><%- ic('pin') %> آدرس تحویل</h3><p style="margin:0"><b><%= o.name %></b> <small dir="ltr" style="color:var(--mut)"><%= o.phone %></small><br><%= o.province %>، <%= o.city %>، <%= o.address %><br><small style="color:var(--mut)">کد پستی: <span dir="ltr"><%= o.postal_code %></span> · ارسال با <%= o.ship_method==='tipax'?'تیپاکس':'پست پیشتاز' %><%= o.ship_collect?' (پس‌کرایه — پرداخت درب منزل)':'' %></small></p></div></div></div>
<%- include('partials/foot') %>
