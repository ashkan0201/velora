<%- include('_h',{t:p.id?'ویرایش محصول':'محصول جدید',sub:p.id?p.name:'اطلاعات محصول را وارد کنید'}) %>
<form method="post" action="<%= ADM %>/products/save?_csrf=<%= csrf %>" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= p.id||'' %>"><input type="hidden" name="old_image" value="<%= p.image||'' %>">
<div class="tabs2"><button type="button" data-tab="p1"><%- ic('bag') %> اطلاعات اصلی</button><button type="button" data-tab="p2"><%- ic('flask') %> توضیحات تکمیلی</button><button type="button" data-tab="p3"><%- ic('image') %> تصاویر</button></div>
<div class="pf"><div>
<div class="tp" id="p1"><div class="card"><h3>اطلاعات پایه</h3><label>نام محصول <span class="req">*</span></label><input name="name" required value="<%= p.name||'' %>" placeholder="مثلاً سرم ویتامین C">
<div class="fgrid"><div><label>برند</label><input name="brand" value="<%= p.brand||'' %>"></div><div><label>حجم / وزن</label><input name="size" value="<%= p.size||'' %>" placeholder="۳۰ میلی‌لیتر"></div></div>
<label>توضیح کوتاه</label><input name="brief" maxlength="80" value="<%= p.brief||'' %>" placeholder="چند کلمه برای کارت محصول"><p class="help">زیر نام محصول در فروشگاه نمایش داده می‌شود.</p>
<% const cur=allcats.find(x=>x.id==p.category_id); const mainId=cur?(cur.parent_id||cur.id):''; const subId=cur&&cur.parent_id?cur.id:''; %><label>دسته‌بندی اصلی</label><select id="catMain"><option value="">— بدون دسته —</option><% cats.forEach(c=>{ %><option value="<%= c.id %>" <%= c.id==mainId?'selected':'' %>><%= c.name %></option><% }) %></select>
<label>زیرمجموعه</label><select id="catSub" data-sel="<%= subId %>"><option value="">— فقط دستهٔ اصلی —</option><% allcats.filter(x=>x.parent_id).forEach(x=>{ %><option value="<%= x.id %>" data-p="<%= x.parent_id %>"><%= x.name %></option><% }) %></select><input type="hidden" name="category_id" id="catVal" value="<%= p.category_id||'' %>"><p class="help">اول دستهٔ اصلی را انتخاب کنید؛ بعد در صورت نیاز زیرمجموعهٔ آن را.</p></div>
<div class="card"><h3>قیمت و موجودی</h3><div class="fgrid"><div><label>قیمت (تومان) <span class="req">*</span></label><input type="number" name="price" min="0" required value="<%= p.price %>"></div><div><label>درصد تخفیف</label><input type="number" name="discount" min="0" max="95" value="<%= p.discount %>"></div><div><label>تعداد موجودی</label><input type="number" name="stock" min="0" value="<%= p.stock %>"></div></div><div><label class="sw"><span>پس‌کرایه (کرایه درب منزل از مشتری گرفته شود)</span><input type="checkbox" name="ship_collect" value="1" <%= p.ship_collect?'checked':'' %>><i></i></label></div><div class="dealbox" id="dealbox"><label>مدت تخفیف</label><select id="jrel"><option value="0">بدون محدودیت زمانی (تخفیف دائمی)</option><option value="1">۱ روز (۲۴ ساعت)</option><option value="2">۲ روز (۴۸ ساعت)</option><option value="3">۳ روز</option><option value="7">۷ روز (یک هفته)</option><option value="14">۱۴ روز</option><option value="30">۳۰ روز</option></select>
<details class="exact"><summary>انتخاب تاریخ و ساعت دقیق (شمسی)</summary><input type="hidden" name="deal_ends" id="dealIso" value="<%= p.deal_ends||'' %>"><div class="jd" id="jd"><div><small>سال</small><select id="jy"></select></div><div><small>ماه</small><select id="jm"></select></div><div><small>روز</small><select id="jdd"></select></div><div class="j2"><small>ساعت</small><select id="jh"></select></div><div class="j2"><small>دقیقه</small><select id="jmi"></select></div></div></details>
<p class="help" id="jdp">اگر مدت بگذارید، تخفیف در سایت با شمارش معکوس نمایش داده می‌شود و بعد از پایان خودکار برداشته می‌شود.</p></div><div class="priceprev" id="pp"></div></div></div>
<div class="tp" id="p2"><div class="card"><h3>توضیحات</h3><label>توضیحات کامل</label><textarea name="description" rows="6"><%= p.description||'' %></textarea>
<label>ویژگی‌های کلیدی</label><textarea name="features" rows="3" placeholder="هر خط یک ویژگی"><%= p.features||'' %></textarea><label>نحوه استفاده</label><textarea name="how_to_use" rows="3"><%= p.how_to_use||'' %></textarea><label>مواد تشکیل‌دهنده</label><textarea name="ingredients" rows="3"><%= p.ingredients||'' %></textarea></div></div>
<div class="tp" id="p3"><div class="card"><h3>تصویر اصلی</h3><label class="drop"><% if(p.image){ %><img class="pv" src="<%= p.image %>" alt=""><% } %><%- ic('image') %><div class="dt">کلیک کنید یا عکس را بکشید و رها کنید</div><input type="file" name="image" accept="image/*"></label></div>
<div class="card"><h3>گالری</h3><p class="hint2">تصاویر بیشتر در صفحهٔ محصول نمایش داده می‌شود.</p><div class="gal2"><% (gallery||[]).forEach(g=>{ %><div class="g"><img src="<%= g.path %>" alt=""><button formaction="<%= ADM %>/gallery/<%= g.id %>/delete?_csrf=<%= csrf %>" formnovalidate title="حذف"><%- ic('x') %></button></div><% }) %></div>
<label class="drop"><%- ic('plus') %><div class="dt">افزودن چند تصویر</div><input type="file" name="gallery" accept="image/*" multiple></label></div></div></div>
<div><div class="card"><h3>نمایش در سایت</h3><label class="sw"><span>فعال<small>نمایش در فروشگاه</small></span><input type="checkbox" name="active" <%= (p.id?p.active:1)?'checked':'' %>><i></i></label>
<label class="sw"><span>محصول منتخب<small>بخش «محصولات منتخب»</small></span><input type="checkbox" name="featured" <%= p.featured?'checked':'' %>><i></i></label>
</div>
<% if(p.id){ %><div class="card"><a class="btn sm o" style="width:100%" target="_blank" href="/product/<%= p.slug %>"><%- ic('eye') %> مشاهده در سایت</a></div><% } %></div></div>
<div class="savebar"><a class="btn o" href="<%= ADM %>/products">انصراف</a><button class="btn"><%- ic('check') %> ذخیره محصول</button></div></form><%- include('_f') %>
