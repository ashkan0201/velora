<%- include('_h',{t:'سفارش‌ها',sub:'مدیریت و پیگیری سفارش مشتریان'}) %>
<div class="tabs2" style="margin-bottom:14px"><a href="<%= ADM %>/orders"><button type="button" class="<%= !st?'on':'' %>">همه</button></a><% Object.entries(ST).forEach(([k,v])=>{ %><a href="<%= ADM %>/orders?status=<%= k %>"><button type="button" class="<%= st===k?'on':'' %>"><%= v[0] %> <span class="pill mute"><%= fa(cnt[k]||0) %></span></button></a><% }) %></div>
<div class="tools"><div class="sbox"><%- ic('search') %><input data-filter placeholder="جستجوی نام، موبایل یا شماره سفارش..."></div></div>
<div class="tbl"><div class="scr"><table id="tbl"><thead><tr><th>سفارش</th><th>مشتری</th><th>مبلغ (تومان)</th><th>وضعیت</th><th>تاریخ</th><th></th></tr></thead><tbody><% rows.forEach(o=>{ const s=ST[o.status]||[o.status,'mute']; %><tr data-s="<%= o.id+' '+o.name+' '+o.phone %>"><td><b>#<%= fa(o.id) %></b></td><td><div class="cell"><div><b><%= o.name %></b><small dir="ltr"><%= o.phone %></small></div></div></td><td><b><%= fa(o.total) %></b><%= o.ship_collect?' · پس‌کرایه':'' %></td><td><span class="pill <%= s[1] %>"><%= s[0] %></span></td><td><%= fd(o.created) %></td><td><div class="acts2"><a class="ib" href="<%= ADM %>/orders/<%= o.id %>"><%- ic('eye') %></a></div></td></tr><% }) %></tbody></table></div>
<div class="empty2" id="noRes" style="display:<%= rows.length?'none':'block' %>"><%- ic('box') %><p>سفارشی یافت نشد.</p></div></div><%- include('_f') %>
