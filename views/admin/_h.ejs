<!DOCTYPE html><html lang="fa" dir="rtl"><head><script src="/js/theme.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf" content="<%= csrf %>"><meta name="robots" content="noindex"><link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<title><%= typeof t!=='undefined'?t+' | ':'' %>پنل مدیریت VELORA</title><link rel="stylesheet" href="/css/style.css?v=<%= v %>"><link rel="stylesheet" href="/css/admin.css?v=<%= v %>"></head>
<body class="adminbody"><div class="adm"><aside><div class="asin">
<a class="brand" href="<%= ADM %>"><img src="/img/logo.svg" alt="VELORA"></a>
<% const L=(h,i,n,b)=>`<a href="${h}" class="${(h===ADM?ap===ADM:ap.startsWith(h))?'on':''}">${ic(i)}<span>${n}</span>${b?`<em class="bd" style="font-style:normal">${b}</em>`:''}</a>`; %>
<%- L(ADM+'','dash','داشبورد') %>
<h6>فروش</h6><%- L(ADM+'/orders','box','سفارش‌ها',badge.orders) %><%- L(ADM+'/users','users','مشتریان') %><%- L(ADM+'/sms','chat','پنل پیامک') %><%- L(ADM+'/carts','bag','سبدهای خرید') %><%- L(ADM+'/coupons','ticket','کدهای تخفیف') %><%- L(ADM+'/reviews','chat','نظرات') %>
<h6>کاتالوگ</h6><%- L(ADM+'/products','bag','محصولات',badge.low) %><%- L(ADM+'/categories','folder','دسته‌بندی‌ها') %><%- L(ADM+'/banners','image','بنرهای صفحه اصلی') %><%- L(ADM+'/testimonials','chat','نظرات صفحه اصلی') %>
<h6>تنظیمات</h6><%- L(ADM+'/settings','gear','اطلاعات فروشگاه و سئو') %><%- L(ADM+'/payment','card','درگاه پرداخت') %><%- L(ADM+'/audit','shield','گزارش امنیتی') %>
<div class="me"><span class="av"><%= (admin&&admin.username||'A')[0].toUpperCase() %></span><div style="flex:1"><%= admin&&admin.username %><br><small style="color:#8f7f96">مدیر</small></div></div>
<a href="/" target="_blank"><%- ic('ext') %><span>مشاهده سایت</span></a>
<form method="post" action="<%= ADM %>/logout?_csrf=<%= csrf %>"><button class="lk"><%- ic('logout') %><span>خروج</span></button></form></div></aside>
<div class="scrim" id="scrim"></div><div class="mainwrap"><div class="topbar"><button class="iconbtn burger" id="burger" type="button" aria-label="منو"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
<div><h1><%= typeof t!=='undefined'?t:'پنل مدیریت' %></h1><% if(typeof sub!=='undefined'){ %><span class="sub"><%= sub %></span><% } %></div><div class="sp"></div>
<% if(typeof add!=='undefined'){ %><a class="btn sm" href="<%= add[0] %>"><%- ic('plus') %> <%= add[1] %></a><% } %>
<button class="iconbtn tg" id="theme" type="button" aria-label="تم"><%- ic('sun','i-sun') %><%- ic('moon','i-moon') %></button></div>
<main><% if(flash){ %><div class="toast"><%- ic('check') %><%= flash %></div><% } %>
