<%- include('_h',{t:'مشتریان',sub:'کاربرانی که با شماره موبایل وارد شده‌اند'}) %>
<div class="tools"><div class="sbox"><%- ic('search') %><input data-filter placeholder="جستجوی نام یا شماره..."></div></div>
<div class="tbl"><div class="scr"><table id="tbl"><thead><tr><th>مشتری</th><th>آدرس</th><th>سفارش</th><th>عضویت</th><th></th></tr></thead><tbody><% rows.forEach(u=>{ %><tr data-s="<%= u.phone+' '+u.first_name+' '+u.last_name %>"><td><div class="cell"><span class="thumb" style="display:grid;place-items:center;border-radius:50%"><%- ic('user') %></span><div><b><%= (u.first_name+' '+u.last_name).trim()||'بدون نام' %></b><small dir="ltr"><%= u.phone %></small></div></div></td>
<td><%= u.address||'—' %><% if(u.lat){ %> <a class="ib" target="_blank" href="https://www.openstreetmap.org/?mlat=<%= u.lat %>&mlon=<%= u.lng %>"><%- ic('map') %></a><% } %></td><td><span class="pill gold"><%= fa(u.n) %></span></td><td><%= fd(u.created) %></td>
<td><form method="post" action="<%= ADM %>/users/<%= u.id %>/block?_csrf=<%= csrf %>" style="text-align:left"><button class="btn sm <%= u.blocked?'red':'o' %>"><%= u.blocked?'رفع مسدودی':'مسدود' %></button></form><form method="post" action="<%= ADM %>/users/<%= u.id %>/delete?_csrf=<%= csrf %>" data-confirm="کاربر «<%= (u.first_name+' '+u.last_name).trim()||u.phone %>» و آدرس‌هایش حذف شود؟ (سفارش‌های قبلی در سیستم می‌مانند)" style="text-align:left;margin-top:6px"><button class="btn sm red">حذف</button></form></td></tr><% }) %></tbody></table></div>
<div class="empty2" id="noRes" style="display:<%= rows.length?'none':'block' %>"><%- ic('users') %><p>هنوز مشتری ثبت‌نام نکرده.</p></div></div><%- include('_f') %>
