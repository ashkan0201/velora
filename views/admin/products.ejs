<%- include('_h',{t:'محصولات',sub:'مدیریت کالاهای فروشگاه',add:[ADM+'/products/new','محصول جدید']}) %>
<div class="tools"><div class="sbox"><%- ic('search') %><input data-filter placeholder="جستجوی نام، برند یا دسته..."></div>
<select data-fattr="cat"><option value="">همه دسته‌ها</option><% cats.forEach(c=>{ %><option><%= c.name %></option><% }) %></select>
<select data-fattr="st"><option value="">همه وضعیت‌ها</option><option value="low">موجودی کم</option><option value="deal">تخفیف روز</option><option value="off">غیرفعال</option></select>
<form method="post" action="<%= ADM %>/products/clear-discounts?_csrf=<%= csrf %>" data-confirm="تخفیف همه محصولات صفر شود؟" style="margin:0"><button class="btn sm o" style="color:var(--red);border-color:var(--red)"><%- ic('trash') %> حذف همه تخفیف‌ها</button></form><details class="bulk"><summary class="btn sm o"><%- ic('ticket') %> تخفیف گروهی</summary><form method="post" action="<%= ADM %>/products/bulk-discount?_csrf=<%= csrf %>" class="card bp" data-confirm="تخفیف روی محصولات اعمال شود؟"><div><label>۱. روی کدام محصولات؟</label><select name="category_id"><option value="">همه محصولات</option><% cats.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><div><label>۲. درصد تخفیف</label><input type="number" name="discount" min="0" max="95" required placeholder="مثلاً ۲۰ (۰ = حذف تخفیف)"></div><div><label>۳. مدت تخفیف</label><select id="bjrel"><option value="0">بدون محدودیت زمانی</option><option value="1">۱ روز (۲۴ ساعت)</option><option value="2">۲ روز (۴۸ ساعت)</option><option value="3">۳ روز</option><option value="7">۷ روز</option><option value="14">۱۴ روز</option><option value="30">۳۰ روز</option></select></div><details class="exact"><summary>تاریخ و ساعت دقیق (شمسی)</summary><input type="hidden" name="deal_ends" id="bdealIso"><div class="jd"><div><small>سال</small><select id="bjy"></select></div><div><small>ماه</small><select id="bjm"></select></div><div><small>روز</small><select id="bjdd"></select></div><div class="j2"><small>ساعت</small><select id="bjh"></select></div><div class="j2"><small>دقیقه</small><select id="bjmi"></select></div></div></details><button class="btn sm">اعمال تخفیف</button></form></details></div>
<div class="tbl"><div class="scr"><table id="tbl"><thead><tr><th>محصول</th><th>دسته</th><th>قیمت (تومان)</th><th>موجودی</th><th>وضعیت</th><th></th></tr></thead><tbody>
<% rows.forEach(p=>{ const st=!p.active?'off':p.stock<=3?'low':p.daily_deal?'deal':''; %><tr data-s="<%= p.name+' '+p.brand+' '+(p.cat||'')+' '+(p.subcat||'') %>" data-cat="<%= p.cat||'' %>" data-st="<%= st %>">
<td><div class="cell"><% if(p.image){ %><img class="thumb" src="<%= p.image %>" alt=""><% }else{ %><span class="thumb" style="display:grid;place-items:center"><%- ic('image') %></span><% } %><div><b><%= p.name %></b><small><%= p.brand %></small></div></div></td><td><%= p.cat||'—' %><% if(p.subcat){ %><small class="subtag">↳ <%= p.subcat %></small><% } %></td>
<td><b><%= fa(Math.round(p.price*(100-p.discount)/100)) %></b><% if(p.discount>0){ %> <s style="color:var(--mut);font-size:12px"><%= fa(p.price) %></s> <span class="pill bad">٪<%= fa(p.discount) %></span><% } %></td>
<td><span class="pill <%= p.stock>3?'ok':p.stock>0?'warn':'bad' %>"><%= p.stock>0?fa(p.stock)+' عدد':'ناموجود' %></span></td>
<td><% if(!p.active){ %><span class="pill mute">غیرفعال</span><% } %><% if(p.daily_deal){ %> <span class="pill bad"><%- ic('fire') %> تخفیف ویژه</span><% } %><% if(p.deal_ends){ const de=new Date(p.deal_ends); if(!isNaN(de)){ const left=de-Date.now(); %><br><small class="deal-end" style="color:<%= left>0?'var(--mut)':'var(--red)' %>"><%- ic('clock') %> <% if(left>0){ %>تا <%= de.toLocaleDateString('fa-IR',{month:'long',day:'numeric'}) %> ساعت <%= de.toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit',hour12:false}) %> · <span data-left="<%= p.deal_ends %>"></span><% }else{ %>پایان‌یافته<% } %></small><% } } %><% if(p.featured){ %> <span class="pill gold"><%- ic('star') %> منتخب</span><% } %></td>
<td><div class="acts2"><a class="ib" href="/product/<%= p.slug %>" target="_blank" title="مشاهده در سایت"><%- ic('eye') %></a><a class="ib" href="<%= ADM %>/products/<%= p.id %>" title="ویرایش"><%- ic('gear') %></a><form method="post" action="<%= ADM %>/products/<%= p.id %>/delete?_csrf=<%= csrf %>" data-confirm="«<%= p.name %>» حذف شود؟"><button class="ib d" title="حذف"><%- ic('trash') %></button></form></div></td></tr><% }) %></tbody></table></div>
<div class="empty2" id="noRes" style="display:<%= rows.length?'none':'block' %>"><%- ic('bag') %><p>محصولی پیدا نشد.</p><a class="btn sm" href="<%= ADM %>/products/new">افزودن محصول</a></div></div>
<p class="help"><b id="count"><%= fa(rows.length) %></b> محصول نمایش داده می‌شود.</p><%- include('_f') %>
