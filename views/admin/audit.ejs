<%- include('_h',{t:'گزارش امنیتی',sub:'۲۰۰ رویداد آخر (ورود و تغییرات)'}) %>
<form class="tools" method="get" style="display:flex;gap:10px;flex-wrap:wrap"><div class="sbox" style="flex:1;min-width:220px"><%- ic('search') %><input name="q" value="<%= q %>" placeholder="جستجوی کاربر، رویداد، IP یا تاریخ..."></div><select name="t" style="max-width:160px"><option value="">همه رویدادها</option><option value="fail" <%= t==='fail'?'selected':'' %>>فقط ناموفق</option><option value="ok" <%= t==='ok'?'selected':'' %>>فقط موفق</option></select><button class="btn sm">جستجو</button><% if(q||t){ %><a class="btn o sm" href="<%= ADM %>/audit">پاک‌کردن</a><% } %></form>
<p class="help">نمایش <%= fa(rows.length) %> مورد از <%= fa(st.n) %> رویداد ثبت‌شده (<%= fa(st.f) %> ورود ناموفق).</p>
<details class="card guide" style="margin-bottom:14px"><summary><b>راهنمای گزارش امنیتی</b></summary><ul><li>هر ورود به پنل مدیریت (موفق یا ناموفق) و تغییرات مهم (ذخیره محصول، حذف کاربر، تخفیف گروهی، ارسال پیامک...) اینجا ثبت می‌شود.</li><li><span class="pill ok">سبز</span> یعنی رویداد عادی؛ <span class="pill bad">قرمز</span> یعنی تلاش ناموفق برای ورود (<code>login FAIL</code>).</li><li>چند ورود ناموفق پشت‌سرهم از یک IP نشانهٔ حدس رمز است؛ رمز مدیر را در «اطلاعات فروشگاه» عوض کنید.</li><li>در کادر جستجو می‌توانید بر اساس نام کاربری، متن رویداد، IP یا تاریخ فیلتر کنید و با منوی کناری فقط موارد ناموفق را ببینید.</li><li>ورود ناشناس موفق که خودتان انجام نداده‌اید = رمز را فوراً تغییر دهید.</li></ul></details>
<div class="tbl"><div class="scr"><table><thead><tr><th>زمان</th><th>کاربر</th><th>رویداد</th><th>IP</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= fd(r.created) %></td><td><%= r.who %></td><td><span class="pill <%= /FAIL/.test(r.action)?'bad':'ok' %>"><%= r.action %></span></td><td dir="ltr"><%= r.ip %></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><div class="empty2"><%- ic('shield') %><p>موردی یافت نشد.</p></div><% } %></div><%- include('_f') %>
