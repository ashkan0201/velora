<%- include('_h',{t:'سفارش #'+o.id,sub:fd(o.created)}) %>
<div class="card"><%- include('../partials/track',{o}) %></div><div class="g2"><div><div class="tbl"><div class="scr"><table><thead><tr><th>کالا</th><th>تعداد</th><th>قیمت واحد</th><th>جمع</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.name %></b></td><td><%= fa(i.qty) %></td><td><%= fa(i.price) %></td><td><%= fa(i.price*i.qty) %></td></tr><% }) %></tbody></table></div></div>
<div class="card" style="margin-top:18px"><div class="kv"><span>تخفیف</span><b><%= o.discount_amount?fa(o.discount_amount)+' تومان ('+o.coupon+')':'—' %></b><span>مبلغ کل</span><b style="color:var(--gold);font-size:18px"><%= fa(o.total) %> تومان</b></div></div></div>
<div><div class="card"><h3><%- ic('truck') %> وضعیت سفارش</h3><form method="post" action="<%= ADM %>/orders/<%= o.id %>/status?_csrf=<%= csrf %>"><label>تغییر وضعیت</label><select name="status"><% Object.entries(ST).forEach(([k,v])=>{ %><option value="<%= k %>" <%= k==o.status?'selected':'' %>><%= v[0] %></option><% }) %></select><br><br><button class="btn" style="width:100%">ثبت وضعیت</button></form></div>
<div class="card"><h3><%- ic('user') %> مشتری</h3><div class="kv"><span>نام</span><b><%= o.name %></b><span>موبایل</span><b dir="ltr"><%= o.phone %></b><span>استان / شهر</span><b><%= o.province %> / <%= o.city %></b><span>آدرس</span><b><%= o.address %></b><span>کد پستی</span><b dir="ltr"><%= o.postal_code %></b><span>روش ارسال</span><b><%= o.ship_method==='tipax'?'تیپاکس':'پست پیشتاز' %><%= o.ship_collect?' (پس‌کرایه)':'' %></b><% if(o.note){ %><span>توضیح</span><b><%= o.note %></b><% } %></div></div></div></div><%- include('_f') %>
