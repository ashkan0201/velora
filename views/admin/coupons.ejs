<%- include('_h',{t:'کدهای تخفیف',sub:'مشتری در سبد خرید کد را وارد می‌کند'}) %>
<div class="g2 cpgrid"><form method="post" action="<%= ADM %>/coupons/save?_csrf=<%= csrf %>" class="card"><h3><%- ic('plus') %> کد جدید</h3><label>کد <span class="req">*</span></label><input name="code" required dir="ltr" placeholder="WELCOME10" style="text-transform:uppercase"><label>درصد تخفیف <span class="req">*</span></label><input type="number" name="percent" min="1" max="100" required>
<label>سقف مبلغ تخفیف (تومان)</label><input type="number" name="max_amount" value="0"><p class="help">۰ یعنی بدون سقف</p><label>حداقل مبلغ سفارش</label><input type="number" name="min_order" value="0"><label>تاریخ انقضا</label><input type="date" name="expires"><label>حداکثر تعداد استفاده</label><input type="number" name="usage_limit" value="0"><p class="help">۰ یعنی نامحدود</p><br><button class="btn" style="width:100%">افزودن کد</button></form>
<div class="tbl"><div class="scr"><table class="cpt"><thead><tr><th>کد</th><th>تخفیف</th><th>شرایط</th><th>استفاده</th><th></th></tr></thead><tbody><% rows.forEach(c=>{ %><tr><td data-l="کد"><b dir="ltr" class="pill gold" style="font-size:14px"><%= c.code %></b></td><td data-l="تخفیف"><b>٪<%= fa(c.percent) %></b></td><td data-l="شرایط"><small>حداقل <%= fa(c.min_order) %> · سقف <%= c.max_amount?fa(c.max_amount):'—' %><br>انقضا: <%= c.expires||'—' %></small></td><td data-l="استفاده"><%= fa(c.used) %> / <%= c.usage_limit?fa(c.usage_limit):'∞' %></td>
<td><div class="acts2"><form method="post" action="<%= ADM %>/coupons/<%= c.id %>/toggle?_csrf=<%= csrf %>"><button class="pill <%= c.active?'ok':'mute' %>" style="border:0;cursor:pointer;font:inherit"><%= c.active?'فعال':'غیرفعال' %></button></form><form method="post" action="<%= ADM %>/coupons/<%= c.id %>/delete?_csrf=<%= csrf %>" data-confirm="حذف شود؟"><button class="ib d"><%- ic('trash') %></button></form></div></td></tr><% }) %></tbody></table></div>
<% if(!rows.length){ %><div class="empty2"><%- ic('ticket') %><p>هنوز کدی نساخته‌اید.</p></div><% } %></div></div><%- include('_f') %>
