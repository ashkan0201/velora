<%- include('_h',{t:'سبدهای خرید',sub:'محصولاتی که مشتریان یا بازدیدکنندگان ناشناس به سبد اضافه کرده‌اند'}) %>
<div class="tbl"><div class="scr"><table><thead><tr><th>کاربر</th><th>محصولات</th><th>جمع (تومان)</th><th>آخرین تغییر</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><% if(r.user_id){ %><span class="pill ok">با حساب</span> <b><%= ((r.first_name||'')+' '+(r.last_name||'')).trim()||'کاربر' %></b><br><small dir="ltr"><%= r.phone||r.email||'' %></small><% }else{ %><span class="pill mute">ناشناس</span><% } %></td><td><% r.items.forEach(i=>{ %><div><%= i.name %> × <%= fa(i.qty) %></div><% }) %></td><td><b><%= fa(r.total) %></b></td><td><%= fd(r.updated) %></td></tr><% }) %></tbody></table></div>
<% if(!rows.length){ %><div class="empty2"><%- ic('bag') %><p>سبد فعالی وجود ندارد.</p></div><% } %></div><%- include('_f') %>
