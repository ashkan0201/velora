<%- include('_h',{t:'سبدهای خرید',sub:'سبدی که ۱ روز به پرداخت نرسد خودکار حذف می‌شود'}) %>
<div class="tbl"><div class="scr"><table><thead><tr><th>کاربر</th><th>محصولات</th><th>جمع (تومان)</th><th>آخرین تغییر</th><th>زمان باقی‌مانده تا حذف</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><% if(r.user_id){ %><span class="pill ok">با حساب</span> <b><%= ((r.first_name||'')+' '+(r.last_name||'')).trim()||'کاربر' %></b><br><small dir="ltr"><%= r.phone||r.email||'' %></small><% }else{ %><span class="pill mute">ناشناس</span><% } %></td><td><% r.items.forEach(i=>{ %><div class="ci"><span><%= i.name %> × <%= fa(i.qty) %></span><form method="post" action="<%= ADM %>/carts/remove?_csrf=<%= csrf %>" data-confirm="این محصول از سبد حذف شود؟"><input type="hidden" name="owner" value="<%= r.owner %>"><input type="hidden" name="pid" value="<%= i.id %>"><button class="ib d" title="حذف محصول"><%- ic('trash') %></button></form></div><% }) %></td><td><b><%= fa(r.total) %></b></td><td><%= fd(r.updated) %></td><td><span class="pill <%= r.left<7200?'bad':'warn' %>" data-secs="<%= r.left %>"></span></td><td><form method="post" action="<%= ADM %>/carts/clear?_csrf=<%= csrf %>" data-confirm="کل سبد این کاربر حذف شود؟"><input type="hidden" name="owner" value="<%= r.owner %>"><button class="btn o sm">حذف کل سبد</button></form></td></tr><% }) %></tbody></table></div>
<% if(!rows.length){ %><div class="empty2"><%- ic('bag') %><p>سبد فعالی وجود ندارد.</p></div><% } %></div><script nonce="<%= nonce %>">(function(){const FA=n=>String(n).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d]);const els=[...document.querySelectorAll('[data-secs]')];const t0=Date.now();const run=()=>{els.forEach(e=>{let s=Math.max(0,+e.dataset.secs-Math.floor((Date.now()-t0)/1000));const h=Math.floor(s/3600),m=Math.floor(s%3600/60);e.textContent=s?FA(h)+' ساعت و '+FA(m)+' دقیقه':'در حال حذف...'})};run();setInterval(run,30000)})();</script><%- include('_f') %>
