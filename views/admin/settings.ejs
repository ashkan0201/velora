<%- include('_h',{t:'اطلاعات فروشگاه و سئو',sub:'هرچه اینجا بنویسید در سایت نمایش داده می‌شود'}) %>
<form method="post" action="<%= ADM %>/settings?_csrf=<%= csrf %>"><div class="tabs2"><button type="button" data-tab="s1"><%- ic('bag') %> اطلاعات فروشنده</button><button type="button" data-tab="s2"><%- ic('truck') %> ارسال</button><button type="button" data-tab="s3"><%- ic('image') %> صفحه اصلی</button><button type="button" data-tab="s4"><%- ic('search') %> سئو</button><button type="button" data-tab="s6"><%- ic('mobile') %> پیامک</button><button type="button" data-tab="s5"><%- ic('lock') %> حساب مدیر</button></div>
<div class="tp" id="s1"><div class="card"><h3>اطلاعات تماس</h3><div class="fgrid"><% [['store_name','نام فروشگاه'],['tagline','شعار'],['phone','تلفن ثابت'],['mobile','موبایل'],['email','ایمیل'],['hours','ساعت کاری'],['instagram','اینستاگرام (بدون @)'],['telegram','تلگرام']].forEach(f=>{ %><div><label><%= f[1] %></label><input name="<%= f[0] %>" value="<%= S[f[0]] %>"></div><% }) %><div class="full"><label>آدرس</label><textarea name="address" rows="2"><%= S.address %></textarea></div><div class="full"><label>درباره فروشگاه</label><textarea name="about" rows="3"><%= S.about %></textarea></div><div class="full"><label>متن پاورقی</label><input name="footer_note" value="<%= S.footer_note %>"></div></div></div></div>
<div class="tp" id="s2"><div class="card"><h3>دریافت هزینه ارسال</h3><input type="hidden" name="ship_collect" value="0"><label class="sw"><span>پس‌کرایه (هزینه ارسال از مشتری آنلاین گرفته نشود؛ درب منزل پرداخت شود)</span><input type="checkbox" name="ship_collect" value="1" <%= S.ship_collect==='1'?'checked':'' %>><i></i></label><p class="help">با روشن بودن، هزینه ارسال در فاکتور صفر است و به مشتری «پس‌کرایه» نمایش داده می‌شود.</p></div><div class="card"><h3>هزینه ارسال</h3><div class="fgrid"><div><label>هزینه پست پیشتاز (تومان)</label><input type="number" name="shipping_fee" value="<%= S.shipping_fee %>"></div><div><label>هزینه تیپاکس (تومان)</label><input type="number" name="tipax_fee" value="<%= S.tipax_fee %>"></div><div><label>ارسال رایگان از مبلغ (تومان)</label><input type="number" name="free_shipping" value="<%= S.free_shipping %>"></div><div><label>هزینه بسته‌بندی (تومان)</label><input type="number" min="0" name="pack_fee" value="<%= S.pack_fee||0 %>"></div></div><p class="help">هزینه بسته‌بندی برای هر سفارش یک‌بار به مبلغ نهایی اضافه می‌شود و در سبد، پرداخت و فاکتور نمایش داده می‌شود. ۰ یعنی بدون هزینه.</p></div></div>
<div class="tp" id="s3"><div class="card"><h3>متن اصلی صفحه اصلی</h3><div class="fgrid"><div><label>عنوان</label><input name="hero_title" value="<%= S.hero_title %>"></div><div><label>زیرعنوان</label><input name="hero_sub" value="<%= S.hero_sub %>"></div></div><p class="help">بنرهای تصویری از «بنرهای صفحه اصلی» مدیریت می‌شوند.</p></div>
<div class="card"><h3>نمایش بخش‌ها در صفحه اصلی</h3><p class="help" style="margin-bottom:8px">هر بخش را روشن/خاموش کنید و در پایان «ذخیره تنظیمات» بزنید. وضعیت هر کدام کنار کلید نوشته شده است.</p><input type="hidden" name="sec_banners" value="0"><label class="sw"><span>بنرها</span><input type="checkbox" name="sec_banners" value="1" <%= S.sec_banners!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_cats" value="0"><label class="sw"><span>دسته‌بندی‌ها</span><input type="checkbox" name="sec_cats" value="1" <%= S.sec_cats!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_deals" value="0"><label class="sw"><span>تخفیف‌های ویژه / پربازدیدها</span><input type="checkbox" name="sec_deals" value="1" <%= S.sec_deals!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_brands" value="0"><label class="sw"><span>نوار برندها</span><input type="checkbox" name="sec_brands" value="1" <%= S.sec_brands!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_featured" value="0"><label class="sw"><span>محصولات منتخب</span><input type="checkbox" name="sec_featured" value="1" <%= S.sec_featured!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_stats" value="0"><label class="sw"><span>آمار و ارقام</span><input type="checkbox" name="sec_stats" value="1" <%= S.sec_stats!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_latest" value="0"><label class="sw"><span>تازه‌ترین‌ها</span><input type="checkbox" name="sec_latest" value="1" <%= S.sec_latest!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_trust" value="0"><label class="sw"><span>ضمانت‌ها (اصالت، ارسال…)</span><input type="checkbox" name="sec_trust" value="1" <%= S.sec_trust!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_testi" value="0"><label class="sw"><span>نظر مشتریان</span><input type="checkbox" name="sec_testi" value="1" <%= S.sec_testi!=='0'?'checked':'' %>><i></i></label><input type="hidden" name="sec_news" value="0"><label class="sw"><span>عضویت باشگاه</span><input type="checkbox" name="sec_news" value="1" <%= S.sec_news!=='0'?'checked':'' %>><i></i></label></div>
<div class="card"><h3>آمار و ارقام (مشتری راضی و…)</h3><div class="fgrid"><% for(let i=1;i<=4;i++){ %><div><label>عدد <%= i %></label><input type="number" name="stat<%= i %>_val" value="<%= S['stat'+i+'_val'] %>"></div><div><label>عنوان <%= i %></label><input name="stat<%= i %>_label" value="<%= S['stat'+i+'_label'] %>"></div><% } %></div></div>
<div class="card"><h3>نظرات مشتریان</h3><p class="help">افزودن، ویرایش و حذف نظرات از بخش <a href="<%= ADM %>/testimonials" style="color:var(--gold);font-weight:700">نظرات صفحه اصلی</a>.</p></div>
<div class="card"><h3>نوار برندهای متحرک (صفحه اصلی)</h3><label>نام برندها (هر خط یک برند)</label><textarea name="brands_list" rows="6" dir="ltr"><%= S.brands_list %></textarea><label>مدت یک دور (ثانیه؛ کمتر = سریع‌تر)</label><input type="number" min="5" max="120" name="brands_speed" value="<%= S.brands_speed||25 %>"><p class="help">برای مخفی‌کردن کل نوار، کلید «نوار برندها» بالاتر را خاموش کنید.</p></div>
<div class="card"><h3>نوار متحرک بالای سایت</h3><input type="hidden" name="mq_on" value="0"><label class="sw"><span>نمایش نوار</span><input type="checkbox" name="mq_on" value="1" <%= S.mq_on!=='0'?'checked':'' %>><i></i></label><label>متن‌ها (هر خط یک پیام)</label><textarea name="mq_text" rows="5"><%= S.mq_text %></textarea><label>مدت یک دور (ثانیه؛ کمتر = سریع‌تر)</label><input type="number" min="5" max="120" name="mq_speed" value="<%= S.mq_speed||30 %>"></div></div>
<div class="tp" id="s4"><div class="card"><h3>سئو (گوگل)</h3><label>عنوان سایت</label><input name="seo_title" maxlength="70" value="<%= S.seo_title %>"><p class="help">ایده‌آل: تا ۶۰ نویسه</p><label>توضیحات (متا)</label><textarea name="seo_desc" rows="3" maxlength="170"><%= S.seo_desc %></textarea><p class="help">ایده‌آل: ۱۲۰ تا ۱۶۰ نویسه</p><label>کلمات کلیدی (با ویرگول جدا کنید)</label><input name="seo_keywords" value="<%= S.seo_keywords %>"></div></div>
<div class="tp" id="s6"><div class="card"><h3>پیامک (sms.ir) — کد ورود</h3><p class="help" style="margin-bottom:8px">وضعیت: <b><%= smsHasKey&&S.sms_template?'فعال':'ناقص (کلید یا شناسه قالب خالی است)' %></b></p><input type="hidden" name="sms_on" value="0"><label class="sw"><span>ارسال پیامک واقعی</span><input type="checkbox" name="sms_on" value="1" <%= S.sms_on!=='0'?'checked':'' %>><i></i></label><div class="fgrid"><div><label>شناسه قالب (TemplateId)</label><input name="sms_template" dir="ltr" inputmode="numeric" value="<%= S.sms_template||'' %>"></div><div><label>نام پارامتر کد در قالب</label><input name="sms_param" dir="ltr" value="<%= S.sms_param||'Code' %>"></div></div><label>کلید API (خالی بگذارید تا تغییر نکند)</label><input name="sms_key" type="password" dir="ltr" autocomplete="off" placeholder="<%= smsHasKey?'••••••••••••  (ذخیره شده)':'' %>"><p class="help">در پنل sms.ir، بخش «ارسال سریع»، یک قالب بسازید، مثلاً «کد ورود شما: #Code#». شناسهٔ همان قالب را اینجا بزنید. نام پارامتر باید دقیقاً با نام داخل قالب یکی باشد.</p></div><div class="smsrow"><div class="card" style="margin:0"><h3>آزمایش پیامک</h3><p class="help">ابتدا تنظیمات را ذخیره کنید، بعد شمارهٔ خودتان را بزنید.</p><input name="phone" form="smsTestForm" dir="ltr" placeholder="09xxxxxxxxx" inputmode="tel"><br><br><button class="btn sm" type="submit" form="smsTestForm">ارسال پیامک آزمایشی</button></div><div class="card" style="margin:0"><h3>گزارش ۵ ارسال آخر</h3><% if(smsStat&&smsStat.n){ %><p class="help" style="margin-bottom:8px">کل ارسال‌های ثبت‌شده: <b><%= fa(smsStat.n) %></b> · موفق: <b><%= fa(smsStat.ok) %></b></p><% } %><% if(!smsLog||!smsLog.length){ %><p class="help">هنوز ارسالی ثبت نشده.</p><% }else{ %><div class="scr"><table style="width:100%;font-size:13px"><thead><tr><th>زمان</th><th>شماره</th><th>نوع</th><th>نتیجه</th></tr></thead><tbody><% smsLog.forEach(l=>{ %><tr><td><%= new Date(l.t.replace(' ','T')+'Z').toLocaleString('fa-IR',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %></td><td dir="ltr"><%= l.phone %></td><td><%= l.kind==='test'?'آزمایشی':'کد ورود' %></td><td><span class="pill <%= l.ok?'ok':'bad' %>"><%= l.ok?'موفق':'ناموفق' %></span><% if(!l.ok){ %><br><small><%= l.msg %></small><% } %></td></tr><% }) %></tbody></table></div><% } %></div></div></div>
<div class="savebar"><button class="btn"><%- ic('check') %> ذخیره تنظیمات</button></div></form>
<form id="smsTestForm" method="post" action="<%= ADM %>/sms-test?_csrf=<%= csrf %>"></form>

<div class="tp" id="s5"><form method="post" action="<%= ADM %>/account?_csrf=<%= csrf %>" class="card" id="acc" style="max-width:480px"><h3><%- ic('lock') %> حساب مدیر</h3><p class="hint2">برای هر تغییر، رمز فعلی لازم است.</p><label>رمز فعلی <span class="req">*</span></label><input type="password" name="current" required autocomplete="current-password"><label>نام کاربری</label><input name="username" value="<%= admin.username %>"><label>رمز جدید (حداقل ۶ نویسه)</label><input type="password" name="password" autocomplete="new-password"><br><br><button class="btn">تغییر اطلاعات ورود</button></form></div>
<script nonce="<%= nonce %>"></script><%- include('_f') %>
