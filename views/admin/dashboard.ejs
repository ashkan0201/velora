<%- include('_h',{t:'داشبورد',sub:'نمای کلی فروشگاه'}) %>
<div class="welcome"><div><h2>خوش آمدید، <%= admin.username %></h2><p><%= stats.orders?('شما '+fa(stats.orders)+' سفارش دارید.'):'هنوز سفارشی ثبت نشده؛ از افزودن محصول شروع کنید.' %></p></div><a class="btn" href="<%= ADM %>/products/new"><%- ic('plus') %> افزودن محصول</a></div>
<div class="cards">
<div class="st"><span class="ico"><%- ic('bag') %></span><div><small>محصولات</small><b><%= fa(stats.products) %></b></div></div>
<div class="st"><span class="ico"><%- ic('box') %></span><div><small>سفارش‌ها</small><b><%= fa(stats.orders) %></b></div></div>
<div class="st"><span class="ico"><%- ic('users') %></span><div><small>مشتریان</small><b><%= fa(stats.users) %></b></div></div>
<div class="st"><span class="ico"><%- ic('card') %></span><div><small>درآمد (تومان)</small><b><%= fa(stats.revenue) %></b></div></div></div>
<div class="qa"><a href="<%= ADM %>/products/new"><%- ic('plus') %> محصول جدید</a><a href="<%= ADM %>/categories"><%- ic('folder') %> دسته‌بندی‌ها</a><a href="<%= ADM %>/coupons"><%- ic('ticket') %> کد تخفیف</a><a href="<%= ADM %>/banners"><%- ic('image') %> بنرها</a><a href="<%= ADM %>/settings"><%- ic('gear') %> اطلاعات فروشگاه</a></div>
<div class="g2"><div>
<div class="card"><h3><%- ic('chart') %> فروش ۷ روز اخیر <small style="font-weight:400;color:var(--mut)">(سفارش‌های پرداخت‌شده)</small></h3><% const mx=Math.max(1,...days.map(x=>x.s)),tot=days.reduce((a,x)=>a+x.s,0); %><div class="bars"><% days.forEach(x=>{ %><div style="height:<%= x.s?Math.max(6,x.s/mx*100):3 %>%;<%= x.s?'':'opacity:.25' %>" title="<%= x.d %> — <%= fa(x.s) %> تومان (<%= fa(x.n) %> سفارش)"><small><%= x.d %></small></div><% }) %></div><p class="help" style="margin:26px 0 0">جمع ۷ روز: <b><%= fa(tot) %> تومان</b><% if(!tot){ %> — هنوز فروش موفقی ثبت نشده<% } %></p></div>
<div class="tbl"><div class="scr"><table><thead><tr><th>آخرین سفارش‌ها</th><th>مبلغ</th><th>وضعیت</th></tr></thead><tbody><% recent.forEach(o=>{ const s=ST[o.status]||[o.status,'mute']; %><tr><td><a href="<%= ADM %>/orders/<%= o.id %>"><b>#<%= fa(o.id) %></b> <%= o.name %></a></td><td><%= fa(o.total) %></td><td><span class="pill <%= s[1] %>"><%= s[0] %></span></td></tr><% }) %></tbody></table></div><% if(!recent.length){ %><div class="empty2"><%- ic('box') %><p>سفارشی نیست</p></div><% } %></div></div>
<div><div class="card"><h3><%- ic('eye') %> پربازدیدترین‌ها</h3><% top.forEach(t=>{ %><div class="cell" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line)"><span><%= t.name %></span><span class="pill gold"><%- ic('eye') %> <%= fa(t.views) %></span></div><% }) %><% if(!top.length){ %><p style="color:var(--mut)">—</p><% } %></div>
<div class="card"><h3><%- ic('bell') %> موجودی کم</h3><p class="hint2">محصولاتی که ۳ عدد یا کمتر مانده‌اند</p><% low.forEach(p=>{ %><a class="cell" href="<%= ADM %>/products/<%= p.id %>" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line)"><span><%= p.name %></span><span class="pill <%= p.stock?'warn':'bad' %>"><%= p.stock?fa(p.stock)+' عدد':'تمام شد' %></span></a><% }) %><% if(!low.length){ %><p style="color:var(--mut)">همه‌چیز مرتب است</p><% } %></div></div></div>
<%- include('_f') %>
