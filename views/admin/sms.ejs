<%- include('_h',{t:'پنل پیامک',sub:'ارسال پیامک تکی یا گروهی به مشتریان'}) %>
<% if(!hasKey){ %><div class="card" style="border-color:var(--red)"><b>کلید API پیامک تنظیم نشده.</b> از «اطلاعات فروشگاه و سئو ← پیامک» وارد کنید.</div><% } %>
<form method="post" action="<%= ADM %>/sms/send?_csrf=<%= csrf %>" enctype="multipart/form-data"><div class="smsgrid">
<div class="card"><h3>گیرندگان (از لیست مشتریان)</h3>
<div class="sbox"><%- ic('search') %><input id="rq" placeholder="جستجوی نام یا موبایل..."></div>
<label class="sw" style="margin-top:10px"><span>ارسال به همهٔ مشتریان (<%= fa(users.filter(u=>!u.blocked).length) %> نفر)</span><input type="checkbox" name="all" value="1" id="allc"><i></i></label>
<div style="margin-top:8px;display:flex;gap:8px"><button type="button" class="btn o sm" id="selv">انتخاب نمایان‌ها</button><button type="button" class="btn o sm" id="clr">پاک‌کردن</button><span class="help" id="cnt" style="margin:auto 0"></span></div>
<div class="rcpt" id="rc"><% users.forEach(u=>{ const nm=((u.first_name||'')+' '+(u.last_name||'')).trim()||'بدون نام'; %><label data-s="<%= (nm+' '+u.phone).toLowerCase() %>"><input type="checkbox" name="ids" value="<%= u.id %>"><span><%= nm %></span><small dir="ltr"><%= u.phone %></small></label><% }) %><% if(!users.length){ %><p style="padding:14px">مشتری‌ای ثبت نشده.</p><% } %></div></div>
<div><div class="card"><h3>متن پیام</h3><label>شمارهٔ خط ارسال‌کننده (sms.ir)</label><input name="line" dir="ltr" inputmode="numeric" value="<%= line %>" placeholder="مثلاً 30007732000000"><label>پیام</label><textarea name="message" id="msg" rows="6" maxlength="500" required></textarea><p class="help"><span id="len">۰</span> / ۵۰۰ کاراکتر</p><div class="savebar" style="position:static"><button class="btn" id="go"><%- ic('check') %> ارسال پیامک</button></div></div>
<div class="card" style="margin-top:16px"><h3>راهنما</h3><ul class="guide"><li>گیرنده‌ها از بخش «مشتریان» گرفته می‌شوند. یک نفر یا چند نفر را تیک بزنید، یا «همه» را روشن کنید (کاربران مسدود حذف می‌شوند).</li><li>کلید API در تنظیمات ذخیره می‌شود؛ شمارهٔ خط، خط اختصاصی شما در sms.ir است و یک‌بار ذخیره می‌شود.</li><li>ارسال گروهی در دسته‌های ۱۰۰تایی انجام می‌شود. نتیجه در جدول زیر ثبت می‌شود.</li><li>طول هر پیامک فارسی ۷۰ کاراکتر است؛ پیام بلندتر چند پیامک حساب می‌شود.</li></ul></div></div></div></form>
<div class="tbl" style="margin-top:18px"><div class="scr"><table><thead><tr><th>زمان</th><th>شماره</th><th>وضعیت</th><th>پیام سرویس</th></tr></thead><tbody><% log.forEach(l=>{ %><tr><td><%= fd(l.t) %></td><td dir="ltr"><%= l.phone %></td><td><span class="pill <%= l.ok?'ok':'bad' %>"><%= l.ok?'موفق':'ناموفق' %></span></td><td><%= l.msg %></td></tr><% }) %></tbody></table></div></div>
<script nonce="<%= nonce %>">(function(){const FA=n=>String(n).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d]);const $=s=>document.querySelector(s),rows=[...document.querySelectorAll('#rc label')],ck=()=>[...document.querySelectorAll('#rc input:checked')].length;
const cnt=()=>$('#cnt').textContent=$('#allc').checked?'همه':FA(ck())+' انتخاب‌شده';
$('#rq').addEventListener('input',e=>{const q=e.target.value.trim().toLowerCase();rows.forEach(r=>r.style.display=!q||r.dataset.s.includes(q)?'':'none')});
$('#selv').onclick=()=>{rows.forEach(r=>{if(r.style.display!=='none')r.querySelector('input').checked=true});cnt()};$('#clr').onclick=()=>{rows.forEach(r=>r.querySelector('input').checked=false);$('#allc').checked=false;cnt()};
$('#rc').addEventListener('change',cnt);$('#allc').addEventListener('change',cnt);$('#msg').addEventListener('input',e=>$('#len').textContent=FA(e.target.value.length));
document.querySelector('form[action*="/sms/send"]').addEventListener('submit',e=>{if(!confirm('ارسال پیامک به '+($('#allc').checked?'همهٔ مشتریان':FA(ck())+' نفر')+'؟'))e.preventDefault()});cnt()})();</script>
<%- include('_f') %>
